# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Database Connection (if using direct PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# API Configuration
PORT=8000
APP_NAME=AI Boss Decision Engine
API_VERSION=v1

# LLM — Gemini (Manager + sub-agents that use services/llm_client.py; set LLM_PROVIDER=gemini in .env)
GOOGLE_API_KEY=your_google_ai_studio_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
# Throttle: free tier 429s often; requests are serialized. Tune if you still hit 429
LLM_429_MAX_RETRIES=8
LLM_429_MAX_BACKOFF_SEC=60
LLM_BETWEEN_CALLS_SEC=0.15

# OpenAI (optional, if you switch away from gemini in code)
OPENAI_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.7

# LangChain Configuration
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=your_langchain_api_key_here

# OCR/LLM Configuration (Kai Haung's task)
GLM_API_KEY=your_glm_api_key_here
GLM_API_URL=https://api.glm.ai
TAVILY_API_KEY=your_tavily_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Cloudinary Configuration (for document uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Zhipu AI Configuration (for document extraction AND data writing)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://api.ilmu.ai/v1
ZHIPU_MODEL=nemo-super

