# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Database Connection (if using direct PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# API Configuration
PORT=8000
APP_NAME=AI Boss Decision Engine
API_VERSION=v1

# LLM Configuration (for LangChain agents)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
SIMULATOR_MODEL=openai:gpt-4o-mini
PARSER_MODEL=
SELECTOR_MODEL=
PERSONA_MODEL=
BRANCH_MODEL=
RECOMMENDATION_MODEL=

# LangChain Configuration
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=your_langchain_api_key_here

# OCR/LLM Configuration (Kai Haung's task)
GLM_API_KEY=your_glm_api_key_here
GLM_API_URL=https://api.glm.ai

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
